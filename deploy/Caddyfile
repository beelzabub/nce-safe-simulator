# Caddy config for the single-box deployment of nce-safe-sim.com.
# Caddy terminates TLS (auto-provisioned + auto-renewed from Let's Encrypt)
# on ports 80/443 and reverse-proxies to the internal `nce-safe-sim` app
# container (non-root, listening on 8080 — #304) on the shared `nce-net`
# Docker network.
#
# Brought up by scripts/deploy-local.sh; the app container is swapped in
# place by scripts/redeploy.sh without touching Caddy.

{
	email jgpowers52@hotmail.com
}

nce-safe-sim.com, www.nce-safe-sim.com {
	encode gzip

	# `reverse_proxy nce-safe-sim:8080` resolves the container name once, at
	# config load, and pins the address. redeploy.sh recreates the app
	# container, which usually draws a *new* address off the nce-net pool, so
	# a pinned upstream leaves Caddy dialling a container that no longer
	# exists — the site 502s until Caddy is restarted or the app happens to
	# reclaim its old address. The dynamic upstream re-resolves the name
	# against Docker's embedded DNS instead, so the swap is picked up on its
	# own and "without touching Caddy" above stays true.
	reverse_proxy {
		dynamic a {
			name nce-safe-sim
			port 8080
			refresh 5s
		}
	}
}
